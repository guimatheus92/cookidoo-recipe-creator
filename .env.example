# Copy to .env:  cp .env.example .env
# Everything here is optional — the values below are already the defaults.
# Real environment variables win over .env; CLI flags win over both.

# Cookidoo cookie file: a Netscape cookies.txt export, OR a file holding a raw
# "name=value; name=value" Cookie header. Any name or path works.
# Relative paths resolve from the project root. Keep it in the root and .gitignore
# already covers it (any root file whose name contains "cookie").
COOKIES_FILE=cookies.txt

# Host that accepts this account's cookies. Varies per account — the regional
# portal (e.g. cookidoo.pt) often does NOT get them. Confirm with --check-auth.
COOKIDOO_HOST=cookidoo.international

# Created-recipes locale. Must return JSON (not a 307) for your account.
COOKIDOO_LOCALE=pt-BR
